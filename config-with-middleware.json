{
    "mcpServers": {
        "github": {
            "type": "local",
            "container": "ghcr.io/github/github-mcp-server:latest",
            "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": ""
            }
        },
        "fetch": {
            "type": "local",
            "container": "mcp/fetch"
        }
    },
    "gateway": {
        "middleware": {
            "jsonl_log": {
                "enabled": true,
                "file_path": "./logs/mcp-requests.jsonl"
            }
        }
    }
}
